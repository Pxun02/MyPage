---
type Props = { current: number; variant?: 'navigation' | 'selector' } & (
    | { kind: 'gohan' }
    | { kind: 'beancurd'; totalItems: number; pageSize: number }
);

const props = Astro.props;
const pages = props.kind === 'gohan'
    ? Object.keys(import.meta.glob('../pages/jp/gohan/*.astro'))
        .flatMap((path) => {
            const year = path.match(/\/(\d{4})\.astro$/)?.[1];
            return year ? [Number(year)] : [];
        })
        .sort((a, b) => a - b)
    : Array.from({ length: Math.ceil(props.totalItems / props.pageSize) }, (_, index) => index + 1);
const currentIndex = pages.indexOf(props.current);
const previous = pages[currentIndex - 1];
const next = pages[currentIndex + 1];
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/jp/${props.kind}`;
const isYear = props.kind === 'gohan';
---

{props.variant === 'selector' ? (
<div class="ranking-selector">
    {!isYear && <span>豆花ランキング</span>}
    <select class="page-picker" data-ranking-page-select aria-label={isYear ? '年を選択' : '順位を選択'}>
        {pages.map((page) => (
            <option value={`${basePath}/${page}`} selected={page === props.current}>
                {props.kind === 'gohan' ? `${page}年` : `${(page - 1) * props.pageSize + 1}〜${Math.min(page * props.pageSize, props.totalItems)}位`}
            </option>
        ))}
    </select>
</div>
) : (
<nav class="pagination ranking-pagination" aria-label={isYear ? 'ご飯ランキングの年切り替え' : '豆花ランキングの順位切り替え'}>
    {previous !== undefined ? (
        <a href={`${basePath}/${previous}`} class="prev-page">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
            {isYear ? previous : 'Previous'}
        </a>
    ) : <span aria-hidden="true"></span>}

    {next !== undefined ? (
        <a href={`${basePath}/${next}`} class="next-page">
            {isYear ? next : 'Next'}
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </a>
    ) : <span aria-hidden="true"></span>}
</nav>
)}

<script>
    document.addEventListener('change', (event) => {
        const select = event.target;
        if (select instanceof HTMLSelectElement && select.matches('[data-ranking-page-select]')) {
            window.location.assign(select.value);
        }
    });
</script>

<style>
    .ranking-pagination {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .ranking-selector {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1rem;
        padding: 0.35rem 0.7rem;
        background: linear-gradient(90deg, var(--accent-light), transparent);
        border-left: 3px solid var(--accent);
        border-radius: 0 4px 4px 0;
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
    }

    .prev-page {
        justify-self: start;
    }

    .next-page {
        justify-self: end;
    }

    .ranking-pagination a {
        padding: 0.25rem 0.55rem;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .page-picker {
        min-height: 2rem;
        max-width: 100%;
        padding: 0.2rem 0.45rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background-color: transparent;
        color: var(--accent);
        font: inherit;
        font-size: 0.85rem;
        line-height: 1.5;
        font-weight: 600;
        cursor: pointer;
    }

    .page-picker:hover {
        border-color: var(--accent);
    }

    .page-picker:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }
</style>
